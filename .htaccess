# =========================================================
# TMS - Secure Routing with .htaccess
# =========================================================
# Features:
# - Block access to sensitive directories
# - Clean URLs for auth routes
# - Clean URLs for admin routes
# - Redirect root to login
# - Handle missing files gracefully
# =========================================================

RewriteEngine On

# ---------------------------------------------------------
# 1. SECURITY: Block access to sensitive directories
# ---------------------------------------------------------
RewriteRule ^(config|app|database|gulp|src|vendors)/ - [F,L]
RewriteRule ^\.env - [F,L]
RewriteRule ^\.env\. - [F,L]
RewriteRule ^composer\.json - [F,L]
RewriteRule ^composer\.lock - [F,L]
RewriteRule ^package\.json - [F,L]
RewriteRule ^package-lock\.json - [F,L]
RewriteRule ^gulpfile\.js - [F,L]
RewriteRule ^\.babelrc - [F,L]
RewriteRule ^\.eslintrc - [F,L]
RewriteRule ^\.prettierignore - [F,L]
RewriteRule ^\.npmrc - [F,L]
RewriteRule ^\.git - [F,L]
RewriteRule ^phpinfo\.php - [F,L]
RewriteRule ^test_cashier_performance\.php - [F,L]
RewriteRule ^user_accounts_columns\.txt - [F,L]
RewriteRule ^backups/ - [F,L]
RewriteRule ^database/ - [F,L]
RewriteRule ^scripts/ - [F,L]

# ---------------------------------------------------------
# 2. ADMIN ROUTES - Use router for auto-discovery
# ---------------------------------------------------------
# /admin -> admin/router.php (slash after admin is optional to handle typos)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^admin/?(.*)$ admin/router.php [L]

# ---------------------------------------------------------
# 3. API ROUTES - Use router for auto-discovery
# ---------------------------------------------------------
# Serve static image files in api/images/ directly (bypass router)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^api/images/ - [L]

# Route all other /api/* requests to router (with or without trailing slash)
RewriteRule ^api/(.*)/?$ api/router.php [L]

# ---------------------------------------------------------
# 4. AUTH ROUTES - Clean URLs
# ---------------------------------------------------------
RewriteRule ^login$ auth/login.php [L]
RewriteRule ^register$ auth/register.php [L]
RewriteRule ^forgot-password$ auth/forgot-password.php [L]
RewriteRule ^auth/forgot-password-handler$ auth/forgot-password-handler.php [L]
RewriteRule ^forgot-password-handler$ auth/forgot-password-handler.php [L]
RewriteRule ^reset-password-handler\.php$ auth/reset-password-handler.php [L]
RewriteRule ^reset-password-handler$ auth/reset-password-handler.php [L]
RewriteRule ^reset-password$ auth/reset-password.php [L]
RewriteRule ^confirm-mail$ auth/confirm-mail.php [L]
RewriteRule ^lock-screen$ auth/lock-screen.php [L]
RewriteRule ^logout$ auth/logout.php [L]
RewriteRule ^gmail-callback$ auth/gmail-callback.php [L]

# ---------------------------------------------------------
# 5. ROOT REDIRECT - Send to login
# ---------------------------------------------------------
# If the request is just "/" or a single segment without a file
RewriteCond %{REQUEST_URI} ^/[^/]+/?$
RewriteRule ^.*$ auth/login.php [L]

# If the request is exactly "/"
RewriteCond %{REQUEST_URI} ^/?$
RewriteRule ^.*$ auth/login.php [L]

# ---------------------------------------------------------
# 5. CUSTOM 404 PAGE
# ---------------------------------------------------------
ErrorDocument 404 /public/pages/errors/404.html

# ---------------------------------------------------------
# 6. SECURITY HEADERS
# ---------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://js.pusher.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://cdn.jsdelivr.net https://fonts.googleapis.com https://fonts.gstatic.com; connect-src 'self' https://cdn.jsdelivr.net https://*.pusher.com wss://*.pusher.com ws://localhost:* wss://localhost:* ws://localhost.qz.io:* wss://localhost.qz.io:*"
    # HSTS: only sent over HTTPS; once HTTPS is enabled the browser will remember it.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# ---------------------------------------------------------
# 7. DISABLE DIRECTORY BROWSING
# ---------------------------------------------------------
Options -Indexes

# ---------------------------------------------------------
# 8. PREVENT ACCESS TO HIDDEN FILES
# ---------------------------------------------------------
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# ---------------------------------------------------------
# 9. PREVENT ACCESS TO BACKUP FILES
# ---------------------------------------------------------
<FilesMatch "\.(bak|backup|old|orig|save|swp)$">
    Order allow,deny
    Deny from all
</FilesMatch>
